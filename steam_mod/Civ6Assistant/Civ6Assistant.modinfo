<?xml version="1.0" encoding="utf-8"?>
<Mod id="d8b21fb4-f6ab-4779-b794-35c4c388db97" version="3">
  <Properties>
    <Name>Civ VI AI Assistant</Name>
    <Description>Ask strategy questions and read OpenAI advice inside Civ VI. Requires the local Windows bridge.</Description>
    <Authors>civ6aiAssistant</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <InGameActions><AddUserInterfaces id="CIV6AI_UI"><Properties><Context>InGame</Context></Properties><File>Advisor.xml</File></AddUserInterfaces></InGameActions>
  <Files><File>Advisor.xml</File><File>Advisor.lua</File></Files>
</Mod>
